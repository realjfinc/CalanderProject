rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each changed document must be named in the same atomic quota update.
    // Server time controls the one-hour window; clients cannot reset it early.
    function validWriteQuota(userId) {
      let path = /databases/$(database)/documents/clientWriteLimits/$(userId);
      let next = getAfter(path).data;
      return request.auth != null && request.auth.uid == userId
        && next.keys().hasOnly(['windowStart', 'count', 'paths', 'updatedAt'])
        && next.paths is list && next.paths.size() > 0 && next.paths.size() <= 20
        && next.count is int && next.count > 0 && next.count <= 100
        && next.windowStart is timestamp && next.updatedAt == request.time
        && (
          (!exists(path) && next.windowStart == request.time && next.count == next.paths.size())
          || (exists(path) && (
            (request.time >= get(path).data.windowStart + duration.value(1, 'h')
              && next.windowStart == request.time && next.count == next.paths.size())
            || (request.time < get(path).data.windowStart + duration.value(1, 'h')
              && next.windowStart == get(path).data.windowStart
              && next.count == get(path).data.count + next.paths.size())
          ))
        );
    }

    // Generalized over any document path (not just this user's own
    // `users/{userId}/...` tree) so the same account-wide quota also
    // covers the one deliberate exception to "only the poller writes
    // sportsTeamGames" below: a live top-up when a client finds nothing
    // cached yet for a team it just followed.
    function limitedWritePath(userId, path) {
      return validWriteQuota(userId)
        && path in getAfter(/databases/$(database)/documents/clientWriteLimits/$(userId)).data.paths;
    }

    function limitedWrite(userId, collectionId, documentId) {
      return limitedWritePath(userId, 'users/' + userId + '/' + collectionId + '/' + documentId);
    }

    match /clientWriteLimits/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create, update: if validWriteQuota(userId);
      allow delete: if false;
    }

    match /users/{userId} {
      // Existing tag and initialization access stays scoped to the owner.
      match /tags/{tagId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if limitedWrite(userId, 'tags', tagId);
      }

      match /meta/{metaId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if limitedWrite(userId, 'meta', metaId);
      }

      // Per-user settings, including tag-routing rules (Step 5).
      match /settings/{settingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if limitedWrite(userId, 'settings', settingId);
      }

      // Per-user followed sports teams (Step 7).
      match /followedTeams/{teamId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if limitedWrite(userId, 'followedTeams', teamId);
      }

      // Events synced from followed sports teams (Step 7) go through this
      // same schema-validated rule -- the scheduled polling function
      // writes via the Admin SDK, which bypasses these rules entirely, and
      // `sports` is already an allowed `source` value below.
      match /events/{eventId} {
        // Scoped to the owning authenticated user only -- same model as
        // every other per-user collection above. This used to also require
        // `request.auth.token.email_verified == true`, but that check
        // bought little: the calendar UI itself is already fully gated
        // behind VerificationScreen for a verified session, and
        // TagRoutingReconciler (wired from main(), independently of that
        // UI gate) writes to events for a signed-in account regardless of
        // verification status -- so an unverified user's own background
        // tag-routing writes were already reaching Firestore and getting
        // silently denied here anyway.
        //
        // Worse, it was actively harmful: a signed-in ID token's
        // `email_verified` claim can lag the account's actual verification
        // state by anywhere from seconds to minutes -- a known Firebase
        // behavior, since verifying updates the local user profile
        // immediately but the ID token used for Firestore requests only
        // reflects that once it's explicitly force-refreshed. That surfaced
        // as "Your calendar could not be accessed. Check that you're
        // signed in" for users who genuinely were.
        function owner() {
          return request.auth != null && request.auth.uid == userId;
        }

        // Bounds a list's length and, for however many of its first
        // maxLen slots are actually present, each element's own type and
        // string length -- Firestore rules have no per-element `.every()`,
        // so this unrolls the check up to a fixed, generous cap rather
        // than leaving the list's contents completely unvalidated (still
        // backstopped by Firestore's 1 MiB document limit either way, but
        // that's a much coarser and later line of defense).
        function validStringList(list, maxLen, maxItemLen) {
          return list is list && list.size() <= maxLen
            && (list.size() < 1 || (list[0] is string && list[0].size() <= maxItemLen))
            && (list.size() < 2 || (list[1] is string && list[1].size() <= maxItemLen))
            && (list.size() < 3 || (list[2] is string && list[2].size() <= maxItemLen))
            && (list.size() < 4 || (list[3] is string && list[3].size() <= maxItemLen))
            && (list.size() < 5 || (list[4] is string && list[4].size() <= maxItemLen));
        }

        function validEvent() {
          let event = request.resource.data;
          return event.keys().hasAll(['title', 'location', 'notes', 'startAt',
              'endAt', 'allDay', 'flexible', 'tagId', 'updatedAt'])
            && event.keys().hasOnly(['title', 'location', 'notes', 'startAt',
              'endAt', 'allDay', 'flexible', 'tagId', 'createdAt', 'updatedAt',
              'start', 'end', 'source', 'sourceId', 'status', 'tag', 'importance',
              'attachments', 'repeat', 'reminders', 'conflictGroupId', 'conflictRole'])
            && event.title is string && event.title.size() > 0 && event.title.size() <= 200
            && event.location is string && event.location.size() <= 300
            && event.notes is string && event.notes.size() <= 5000
            && event.startAt is timestamp && event.endAt is timestamp
            && event.endAt > event.startAt
            && event.allDay is bool && event.flexible is bool
            && (event.tagId == null || (event.tagId is string && event.tagId.size() <= 128))
            && (!('source' in event) || (
              event.source in ['manual', 'upload', 'screenshot', 'google', 'outlook', 'icloud', 'sports']
              && event.status in ['active', 'pendingConflict']
              && event.importance in ['locked', 'flexible']
              && event.start == event.startAt && event.end == event.endAt
              && event.tag == event.tagId
              && event.flexible == (event.importance == 'flexible')
              && (event.sourceId == null || event.sourceId is string)
              && (event.attachments == null || validStringList(event.attachments, 5, 2000))
              && (event.repeat == null || event.repeat is map)
              && (event.reminders == null || (
                event.reminders is list && event.reminders.size() <= 20
                && event.reminders.hasOnly(['fiveMinutes', 'tenMinutes', 'fifteenMinutes',
                  'thirtyMinutes', 'oneHour', 'oneDay'])
              ))
              && (event.conflictGroupId == null || event.conflictGroupId is string)
              && (event.conflictRole == null || event.conflictRole in ['original', 'new'])
            ))
            && (!('createdAt' in event) || event.createdAt is timestamp)
            && event.updatedAt == request.time;
        }

        allow read: if owner();
        allow delete: if owner() && limitedWrite(userId, 'events', eventId);
        allow create: if owner() && limitedWrite(userId, 'events', eventId)
          && validEvent() && request.resource.data.createdAt == request.time;
        allow update: if owner() && limitedWrite(userId, 'events', eventId) && validEvent()
          && (('createdAt' in resource.data && request.resource.data.createdAt == resource.data.createdAt)
            || (!('createdAt' in resource.data) && !('createdAt' in request.resource.data)));
      }
    }

    // Global, cross-user cache of every catalog team's upcoming games
    // (Step 7's Python poller populates this for every team the free
    // TheSportsDB key can see, not just teams someone follows -- see
    // scripts/sports_poller/sports_cache_repository.py). Read-only for any
    // signed-in client, so following a new team can immediately copy that
    // team's already-cached games into the user's own events instead of
    // waiting for the next hourly poll. The poller writes via the Admin
    // SDK, which bypasses these rules entirely; the one client write path
    // below exists only for a team the poller hasn't reached yet -- a
    // live top-up on follow, gated by the same account-wide write quota
    // and a validated shape so it can't be used to pollute a collection
    // every signed-in user reads.
    match /sportsTeamGames/{teamId}/games/{gameId} {
      function validCachedGame() {
        let game = request.resource.data;
        return game.keys().hasAll(['title', 'start', 'end', 'sourceId'])
          && game.keys().hasOnly(['title', 'location', 'start', 'end', 'sourceId', 'league'])
          && game.title is string && game.title.size() > 0 && game.title.size() <= 200
          && (game.location == null || (game.location is string && game.location.size() <= 300))
          && game.start is timestamp && game.end is timestamp && game.end > game.start
          && game.sourceId is string && game.sourceId == gameId
          && (game.league == null || (game.league is string && game.league.size() <= 200));
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && limitedWritePath(request.auth.uid, 'sportsTeamGames/' + teamId + '/games/' + gameId)
        && validCachedGame();
      allow delete: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
