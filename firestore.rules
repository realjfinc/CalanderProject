rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Existing tag and initialization access stays scoped to the owner.
      match /tags/{tagId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /events/{eventId} {
        function owner() {
          return request.auth != null && request.auth.uid == userId
            && request.auth.token.email_verified == true;
        }

        function validEvent() {
          let event = request.resource.data;
          return event.keys().hasAll(['title', 'location', 'notes', 'startAt',
              'endAt', 'allDay', 'flexible', 'tagId', 'createdAt', 'updatedAt'])
            && event.keys().hasOnly(['title', 'location', 'notes', 'startAt',
              'endAt', 'allDay', 'flexible', 'tagId', 'createdAt', 'updatedAt'])
            && event.title is string && event.title.size() > 0 && event.title.size() <= 200
            && event.location is string && event.location.size() <= 300
            && event.notes is string && event.notes.size() <= 5000
            && event.startAt is timestamp && event.endAt is timestamp
            && event.endAt > event.startAt
            && event.allDay is bool && event.flexible is bool
            && (event.tagId == null || (event.tagId is string && event.tagId.size() <= 128))
            && event.createdAt is timestamp
            && event.updatedAt == request.time;
        }

        allow read, delete: if owner();
        allow create: if owner() && validEvent() && request.resource.data.createdAt == request.time;
        allow update: if owner() && validEvent()
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
