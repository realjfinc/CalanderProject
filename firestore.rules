rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Per-user tag collection (Step 1). Only the owning, authenticated
      // user may read or write their own tags or tag-init marker.
      match /tags/{tagId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Per-user events, including those synced from providers (Step 6)
      // and from followed sports teams (Step 7). Only the owning,
      // authenticated user may read or write their own events -- the
      // scheduled polling function writes via the Admin SDK, which
      // bypasses these rules entirely.
      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Per-user followed sports teams (Step 7).
      match /followedTeams/{teamId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
